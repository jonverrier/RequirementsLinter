{
   "name": "requirements-linter",
   "version": "0.1.1",
   "description": "Requirements linter functions for the AI-enabled software lifecycle workbench",
   "main": "dist/src/entry.js",
   "directories": {
      "src": "src",
      "test": "test"
   },
   "author": "Jon Verrier",
   "license": "MIT",
   "scripts": {
      "build": "tsc -b && ncp ./src/RequirementsGuidelines.md dist/src/RequirementsGuidelines.md && ncp ./src/UserStoryGuidelines.md dist/src/UserStoryGuidelines.md",
      "setup": "npm install ../PromptRepository",
      "watch": "tsc -b -w",
      "clean": "rimraf dist",
      "prestart": "npm run clean && npm run build",
      "start": "func start",
      "test": "jest --selectProjects unit",
      "test:ci": "jest --selectProjects ci",
      "test:eval": "jest --selectProjects eval",
      "test-mini": "jest --selectProjects mini"
   },
   "devDependencies": {
      "@types/jest": "^29.5.14",
      "@types/node": "^22.13.8",
      "@types/sinon": "^17.0.4",
      "axios": "^1.8.4",
      "expect": "^29.7.0",
      "jest": "^29.7.0",
      "ncp": "^2.0.0",
      "openai": "^4.89.1",
      "rimraf": "^6.0.1",
      "sinon": "^20.0.0",
      "ts-jest": "^29.2.5",
      "tslib": "^2.8.1",
      "typescript": "^5.7.3"
   },
   "dependencies": {
      "@jonverrier/prompt-repository": "file:../PromptRepository"
   }
}
